{
  "name": "pokemon-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "howler": "2.2.4",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/howler": "2.2.13",
    "@types/node": "20.12.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "9.1.2",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5"
  },
  "overrides": {
    "@babel/runtime": "7.29.7",
    "ajv": "6.15.0",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=2 <3": "2.1.7",
    "braces": "3.0.3",
    "cross-spawn": "7.0.6",
    "flatted": "3.4.4",
    "glob@10": "10.5.0",
    "js-yaml": "4.3.2",
    "micromatch": "4.0.8",
    "postcss": "8.5.28",
    "minimatch@<4": "3.1.5",
    "minimatch@9": "9.0.9",
    "nanoid": "3.3.19",
    "picomatch": "2.3.2",
    "yaml": "2.9.1"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "arrowParens": "always",
    "printWidth": 80,
    "bracketSpacing": true,
    "plugins": [],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "printWidth": 360
        }
      },
      {
        "files": [
          "*.css",
          "*.scss"
        ],
        "options": {
          "singleQuote": false
        }
      }
    ]
  }
}
